# Toolchain image for libmem CI. Arch tracks a new enough clang/gcc for C++26
# modules and `import std`.
FROM archlinux:latest

# Links the published package to the repo, so it inherits the repo's permissions.
LABEL org.opencontainers.image.source=https://github.com/aotodev/libmem

RUN pacman -Syu --noconfirm \
        clang llvm lld \
        gcc \
        libc++ libc++abi \
        cmake ninja \
        git \
    && pacman -Scc --noconfirm

# libc++/libc++abi: hedge so clang's `import std` works regardless of stdlib.
